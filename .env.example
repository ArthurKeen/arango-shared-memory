# Shared-memory configuration — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# NOTE: the scripts do NOT auto-load this file (there is no python-dotenv
# dependency). Every setting is resolved by scripts/*.py via:
#
#     os.environ.get(KEY) or <arangodb-memory-mcp env in mcp.json> or <default>
#
# So a `.env` only takes effect if you export it into the shell first:
#
#     set -a; source .env; set +a
#     python scripts/verify.py
#
# The MCP config is the other supported source, read from the `env` block of the
# `arangodb-memory-mcp` server entry in ~/.claude.json or ~/.cursor/mcp.json.
# Values already set there do not need to be repeated here; env vars win over it.
# Every value below is a default or a placeholder — never commit a filled-in .env
# (`.env` and `*.env` are gitignored; this `.env.example` is deliberately tracked).


# -- ArangoDB connection -------------------------------------------------------
# Comma-separated list; parsed as multiple hosts by ArangoClient.
ARANGO_HOSTS=http://localhost:8539
ARANGO_ROOT_USERNAME=root
ARANGO_ROOT_PASSWORD=
ARANGO_DEFAULT_DB_NAME=memory

# Set to false/0/no/off to skip TLS verification (self-signed dev clusters).
# Read by scripts/verify.py only.
ARANGO_VERIFY_SSL=true


# -- Embeddings ----------------------------------------------------------------
# Required for the vector paths: phase1b_setup.py, phase2b_extract.py,
# eval_retrieval.py, and the embedding backfill in maintain.py. When it does not
# resolve, maintain.py skips the backfill + graph rebuild instead of failing.
OPENAI_API_KEY=

# 1536 dims; phase1b_setup.py sizes the vector index from this model.
EMBEDDING_MODEL=text-embedding-3-small


# -- LLM edge extraction -------------------------------------------------------
# Used by phase2b_extract.py to infer pattern/requirement edges.
LLM_EXTRACTION_MODEL=gpt-4o


# -- Optional ------------------------------------------------------------------
# Set to any non-empty value to suppress recall logging in the session_recall
# hook (templates/.claude/hooks/session_recall.py).
# SHARED_MEMORY_DISABLE_RECALL_LOG=

# Path to the arango MCP server checkout; enables the AQL-sync guard in
# tests/test_eval_aql_sync.py, which is skipped when it cannot locate the module.
# ARANGO_MCP_SERVER_DIR=
